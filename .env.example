# Database / admin
DATABASE_URL="your-db-url"
JWT_SECRET="JWT-Secret"
ADMIN_PASSWORD="adminpassword"

# Public URL + voice webhook
VOICE_SECRET="your-voice-secret"

# Groq (chat) - switches to next key automatically
GROQ_API_KEY_1="your-grok-api-1"
GROQ_API_KEY_2="your-grok-api-2"
GROQ_API_KEY_3="your-grok-api-3"

# Vapi (voice) - switches to next account automatically
VAPI_PUBLIC_KEY_1="your-vapi-api-1"
VAPI_PUBLIC_KEY_2="your-vapi-api-2"
VAPI_PUBLIC_KEY_3="your-vapi-api-3"
VAPI_MINUTES_LIMIT=30
